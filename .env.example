GEMINI_API_KEY=
PORT=3000

# Tunables (all optional; defaults shown):
# WEBBOOK_READ_PAGES=true
# GEMINI_MAX_CONCURRENCY=3
# GEMINI_MAX_ATTEMPTS=4
# GEMINI_MAX_RETRY_WAIT_MS=45000
# GEMINI_REQUEST_TIMEOUT_MS=50000

# Local model (optional): used when no Gemini key works. Two ways to have one:
#   built-in  `npm install` sets up a Gemma model that runs inside this app (runtime + one ~2.8 GB download), or `npm run setup:local-llm` later
#   external  run Ollama / LM Studio / llama-server yourself (e.g. `ollama pull gemma4:e4b`); it is used automatically when it is running
# LLM_PROVIDER=auto            # auto (default) | gemini (never use a local model) | local (never call Google)
# LOCAL_LLM_ENGINE=auto        # auto (default: external server if ready, else built-in) | http (external only) | embedded (built-in only)
#
# External server:
# LOCAL_LLM_BASE_URL=http://localhost:11434
# LOCAL_LLM_MODEL=gemma4:e4b
#
# Built-in model:
# LOCAL_LLM_MODEL_URI=hf:ggml-org/gemma-4-E2B-it-GGUF/gemma-4-E2B-it-Q4_0.gguf
# LOCAL_LLM_MODEL_PATH=        # or point at any .gguf file you already have (wins over the URI)
# LOCAL_LLM_MODELS_DIR=./models
# LOCAL_LLM_CONTEXT_SIZE=16384
# LOCAL_LLM_THREADS=           # default: the number of CPU cores
#
# Both:
# LOCAL_LLM_TIMEOUT_MS=300000
# LOCAL_LLM_MAX_CONCURRENCY=1
# LOCAL_LLM_TEMPERATURE=0.4
#
# Read by `npm install` only (set them in your shell, e.g. SKIP_LOCAL_LLM_SETUP=1 npm install):
# SKIP_LOCAL_LLM_SETUP=1       # do not touch the local model during npm install
# LOCAL_LLM_DOWNLOAD=off       # check the runtime but do not download the model
# LOCAL_LLM_VERIFY=off         # do not load-test the model after installing

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=