GEMINI_API_KEY=
PORT=3000

# Tunables (all optional; defaults shown):
# WEBBOOK_READ_PAGES=true
# GEMINI_MAX_CONCURRENCY=3
# GEMINI_MAX_ATTEMPTS=4
# GEMINI_MAX_RETRY_WAIT_MS=45000
# GEMINI_REQUEST_TIMEOUT_MS=50000

# Local model provider (optional): used when no Gemini key works.
# Needs an OpenAI-compatible server such as Ollama running (e.g. `ollama pull gemma4:e4b`):
# LLM_PROVIDER=auto            # auto (default) | gemini | local
# LOCAL_LLM_BASE_URL=http://localhost:11434
# LOCAL_LLM_MODEL=gemma4:e4b
# LOCAL_LLM_TIMEOUT_MS=300000
# LOCAL_LLM_MAX_CONCURRENCY=1
# LOCAL_LLM_TEMPERATURE=0.4

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=